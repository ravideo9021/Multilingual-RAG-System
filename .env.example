# =====================================================
# Multilingual RAG System — environment configuration
# Copy to .env and fill in your keys.
#
# Recommended setup: OpenRouter or another OpenAI-compatible endpoint
#   1. Get a free key at https://openrouter.ai/keys
#   2. Set OPENAI_API_KEY=<that key>
#   3. Keep OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   4. Set OPENAI_MAIN_MODEL and OPENAI_CHEAP_MODEL to available model slugs
#
# To use OpenAI directly: leave OPENAI_BASE_URL blank and set
# OPENAI_MAIN_MODEL=gpt-4o (or whatever).
# =====================================================

# ----- LLM provider selection -----
# "openai" with OPENAI_BASE_URL pointing at OpenRouter is the default.
# Set LLM_PROVIDER=gemini to use Gemini instead.
LLM_PROVIDER=openai

# ----- OpenAI / OpenRouter (primary) -----
OPENAI_API_KEY=your_openrouter_or_openai_key_here
# Set this to https://openrouter.ai/api/v1 for OpenRouter; leave empty for OpenAI.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Free OpenRouter models (pick one — availability changes; check
# https://openrouter.ai/models?supported_parameters=tools&pricing=free):
#   google/gemma-4-31b-it:free            ← good multilingual incl. Hindi
#   nvidia/nemotron-3-super-120b-a12b:free ← largest free; English-strong
#   google/gemma-4-26b-a4b-it:free
# Free model availability changes; confirm the model slug in your provider dashboard.
OPENAI_MAIN_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENAI_CHEAP_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# ----- Google Gemini (fallback / alternative) -----
GEMINI_API_KEY=your_gemini_key_here_optional
GEMINI_MAIN_MODEL=gemini-2.5-pro
GEMINI_CHEAP_MODEL=gemini-2.5-flash

# ----- Embeddings -----
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=32
DEVICE=auto

# ----- Retrieval -----
RETRIEVAL_TOP_K=5
RRF_K=60
RELEVANCE_THRESHOLD=0.35
FAISS_INDEX_TYPE=flat

# ----- Chunker -----
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=80

# ----- Logging -----
LOG_LEVEL=INFO
